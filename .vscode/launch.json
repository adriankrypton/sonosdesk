{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SonosDesk (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/SonosDesk.App/bin/Debug/net10.0-windows/SonosDesk.dll",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      "name": "SonosDesk (Debug, im Infobereich starten)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/SonosDesk.App/bin/Debug/net10.0-windows/SonosDesk.dll",
      "args": ["--minimized"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    }
  ]
}
