<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Authors>adriankrypton and SonosDesk contributors</Authors>
    <Product>SonosDesk</Product>
    <Copyright>Copyright (c) adriankrypton and SonosDesk contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
