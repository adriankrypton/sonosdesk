<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Local API for the Electron app (macOS and Windows): hosts Core and Infrastructure, bound to 127.0.0.1 only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SonosDesk.Server</RootNamespace>
    <AssemblyName>SonosDesk.Server</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SonosDesk.Core\SonosDesk.Core.csproj" />
    <ProjectReference Include="..\SonosDesk.Infrastructure\SonosDesk.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SonosDesk.Server.Tests" />
  </ItemGroup>

</Project>
