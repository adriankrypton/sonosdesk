<Window x:Class="SonosDesk.App.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SonosDesk.App.Localization"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=InputBox}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="HeaderText" Style="{DynamicResource SubtitleTextBlockStyle}" FontSize="18" />
        <TextBlock x:Name="HintText" Margin="0,8,0,14" TextWrapping="Wrap" Style="{StaticResource SettingHintStyle}" FontSize="13" />
        <ComboBox x:Name="InputBox" IsEditable="True" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:T dlg.prompt.cancel}" MinWidth="100" IsCancel="True" />
            <Button x:Name="OkButton" Content="{l:T dlg.prompt.ok}" MinWidth="120" Margin="8,0,0,0" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
