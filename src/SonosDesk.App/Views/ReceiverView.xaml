<UserControl x:Class="SonosDesk.App.Views.ReceiverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:SonosDesk.App.Localization"
             xmlns:vm="clr-namespace:SonosDesk.App.ViewModels"
             xmlns:views="clr-namespace:SonosDesk.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReceiverViewModel}">
    <!-- Same layout as the Sonos room page (NowPlayingView); only what the receiver supports. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Width="240" Height="240" Content="{Binding}" ContentTemplate="{StaticResource AlbumArtTemplate}">
                    <ContentPresenter.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
                    </ContentPresenter.Effect>
                </ContentPresenter>

                <StackPanel Grid.Column="1" Margin="32,4,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{DynamicResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding LinkBadge}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVisibility}}">
                        <views:BusySpinner Width="12" Height="12" Thickness="2" Margin="0,0,6,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{l:T np.buffering}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayTitle, TargetNullValue={l:T np.nothing_playing}}" Margin="0,4,0,0"
                               Style="{DynamicResource TitleTextBlockStyle}" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DisplayArtist}" Margin="0,6,0,0" FontSize="16" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{Binding DisplayArtist, Converter={StaticResource NullToVisibility}}" />

                    <Border HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,3" CornerRadius="10"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding SourceText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                               Text="{l:T group.unreachable}" Visibility="{Binding IsReachable, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                    <!-- Transport: live radio cannot skip, like radio on Sonos -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8B1;" IsEnabled="False"
                                ToolTip="{l:T np.shuffle}" AutomationProperties.Name="{l:T np.shuffle}" />
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE892;" Margin="12,0,0,0" FontSize="18" Width="44" Height="44" IsEnabled="False"
                                AutomationProperties.Name="{l:T np.previous}" />
                        <Grid Margin="12,0" Width="66" Height="66">
                            <Button Style="{StaticResource PlayButtonStyle}"
                                    Content="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}}"
                                    Command="{Binding PlayPauseCommand}" IsEnabled="{Binding CanPlay}"
                                    ToolTip="{l:T np.play_pause_tooltip}"
                                    AutomationProperties.Name="{Binding IsPlaying, Converter={StaticResource PlayPauseText}}" />
                            <views:BusySpinner Thickness="3" Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                               Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE893;" FontSize="18" Width="44" Height="44" IsEnabled="False"
                                AutomationProperties.Name="{l:T np.next}" />
                        <Button Style="{StaticResource IconButtonStyle}" Margin="12,0,0,0" Content="&#xE8EE;" IsEnabled="False"
                                ToolTip="{l:T np.repeat_tooltip}" AutomationProperties.Name="{l:T np.repeat}" />
                    </StackPanel>

                    <!-- Volume -->
                    <Grid Margin="0,20,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButtonStyle}" Content="{Binding IsMuted, Converter={StaticResource MuteGlyph}}"
                                Command="{Binding ToggleMuteCommand}" ToolTip="{l:T np.mute_tooltip}" AutomationProperties.Name="{l:T np.mute}" />
                        <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding IsOn}"
                                AutomationProperties.Name="{l:T np.volume}" ToolTip="{l:T np.volume_tooltip}" />
                        <TextBlock Grid.Column="2" Text="{Binding Volume}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- My stations, like the Sonos favorites -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:T receiver.stations}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Name, StringFormat={l:T np.favorites_hint}}" Style="{StaticResource SettingHintStyle}" Margin="0,0,0,8" />
                    <TextBlock Text="{l:T receiver.no_stations}" Style="{StaticResource SettingHintStyle}"
                               Visibility="{Binding Stations.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <ItemsControl ItemsSource="{Binding Stations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RadioStationViewModel}">
                                <Button Style="{StaticResource IconButtonStyle}" Width="112" Height="Auto" Margin="0,0,8,8" Padding="4" FontSize="12"
                                        Command="{Binding DataContext.PlayRadioStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Details}" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Margin="4" Width="96">
                                        <Border Width="96" Height="96" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Border CornerRadius="6">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Logo}" Stretch="Uniform" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                                   FontFamily="Segoe UI" TextAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Sound, like on a Sonos room -->
            <Expander IsExpanded="{Binding IsSoundExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,16"
                      Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}">
                <Expander.Header>
                    <StackPanel>
                        <TextBlock Text="{l:T np.sound}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" />
                        <TextBlock Text="{l:T receiver.sound_hint}" Style="{StaticResource SettingHintStyle}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,12,0,0">
                    <views:BusySpinner Width="18" Height="18" Thickness="2" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{Binding IsLoadingTone, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Visibility="{Binding HasTone, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,2,0,10" Width="520" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T receiver.listening_mode}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" MinWidth="260" HorizontalAlignment="Left"
                                      ItemsSource="{Binding ListeningModes}" SelectedItem="{Binding ListeningMode, Mode=TwoWay}"
                                      DisplayMemberPath="Name" AutomationProperties.Name="{l:T receiver.listening_mode}" />
                        </Grid>
                        <TextBlock Text="{l:T receiver.tone_mode_unavailable}" TextWrapping="Wrap" Style="{StaticResource SettingHintStyle}" Margin="0,0,0,8"
                                   Visibility="{Binding IsToneAvailable, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <Grid Margin="0,2" Width="520" HorizontalAlignment="Left" IsEnabled="{Binding IsToneAvailable}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T np.sound_bass}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="{Binding MinToneLevel}" Maximum="{Binding MaxToneLevel}" TickFrequency="1"
                                    IsSnapToTickEnabled="True" TickPlacement="BottomRight" SmallChange="1" LargeChange="2"
                                    Value="{Binding Bass, Mode=TwoWay}" AutomationProperties.Name="{l:T np.sound_bass}" />
                            <TextBlock Grid.Column="2" Text="{Binding Bass}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                        </Grid>
                        <Grid Margin="0,2" Width="520" HorizontalAlignment="Left" IsEnabled="{Binding IsToneAvailable}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T np.sound_treble}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="{Binding MinToneLevel}" Maximum="{Binding MaxToneLevel}" TickFrequency="1"
                                    IsSnapToTickEnabled="True" TickPlacement="BottomRight" SmallChange="1" LargeChange="2"
                                    Value="{Binding Treble, Mode=TwoWay}" AutomationProperties.Name="{l:T np.sound_treble}" />
                            <TextBlock Grid.Column="2" Text="{Binding Treble}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                        </Grid>
                        <Button Content="{l:T np.sound_reset}" Command="{Binding ResetToneCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="{Binding IsToneAvailable}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Grouping: couple the receiver to a Sonos room -->
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{l:T np.group_rooms}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{l:T receiver.group_hint}" Style="{StaticResource SettingHintStyle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding RoomChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReceiverRoomChip}">
                                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding IsLinked, Mode=TwoWay}"
                                              Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding RoomName}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding RoomName}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,0" Text="{Binding SyncNotice}" TextWrapping="Wrap" Style="{StaticResource SettingHintStyle}"
                               Visibility="{Binding SyncNotice, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
