<UserControl x:Class="SonosDesk.App.Views.RadioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SonosDesk.App.ViewModels"
             xmlns:l="clr-namespace:SonosDesk.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RadioViewModel}">
    <UserControl.Resources>
        <!-- One station row: logo, name, details, save toggle, play. -->
        <DataTemplate x:Key="StationTemplate" DataType="{x:Type vm:RadioStationViewModel}">
            <Border Padding="8,6" CornerRadius="6" Background="Transparent" x:Name="Row"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{l:T radio.menu.play}" Command="{Binding PlayCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="{l:T radio.menu.choose_logo}" Command="{Binding ChangeLogoCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{l:T radio.menu.reset_logo}" Command="{Binding ResetLogoCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.HasCustomLogo, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{l:T radio.menu.move_to_folder}" Click="OnMoveToFolder" />
                        <Separator />
                        <MenuItem Header="{l:T radio.menu.toggle_saved}" Command="{Binding ToggleSaveCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Logo}" Stretch="Uniform" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE70F;" FontSize="14"
                            Command="{Binding DataContext.ChangeLogoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{l:T radio.change_logo_tooltip}" AutomationProperties.Name="{l:T radio.change_logo}" />
                    <Button Grid.Column="3" Tag="{Binding IsSaved}"
                            Command="{Binding DataContext.ToggleSaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{l:T radio.toggle_saved}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Content" Value="&#xE734;" />
                                <Setter Property="ToolTip" Value="{l:T radio.add_saved}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                        <Setter Property="Content" Value="&#xE735;" />
                                        <Setter Property="ToolTip" Value="{l:T radio.remove_saved}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="4" Margin="4,0,0,0" Style="{StaticResource PlayButtonStyle}" Width="36" Height="36" FontSize="14" Content="&#xE768;"
                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            IsEnabled="{Binding DataContext.CanPlayStreams, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip="{l:T radio.play_tooltip}" AutomationProperties.Name="{Binding Name, StringFormat={l:T radio.play_station}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,24,32,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72B;" Margin="-8,0,8,0"
                            Command="{Binding DataContext.ShowNowPlayingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{l:T radio.back}" AutomationProperties.Name="{l:T radio.back}" />
                    <TextBlock Text="{l:T radio.title}" Style="{DynamicResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                           Text="{Binding TargetText, StringFormat={l:T radio.plays_in}, TargetNullValue={l:T radio.no_room}}" />
            </Grid>

            <!-- Search -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T radio.search_name}"
                         ToolTip="{l:T radio.search_tooltip}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}"
                          AutomationProperties.Name="{l:T radio.country}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T radio.search}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Genres -->
            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Genres}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,6,6" Padding="10,3" Content="{Binding}"
                                Command="{Binding DataContext.SearchGenreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SettingHintStyle}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{l:T radio.no_stream_support}"
                       Visibility="{Binding CanPlayStreams, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,8,32,24">
                <!-- My stations -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{l:T radio.saved_title}" Style="{StaticResource SectionHeaderStyle}" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0" Padding="10,3" Click="OnAddCustomStation"
                                    ToolTip="{l:T radio.custom_station_tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                                    <TextBlock Text="{l:T radio.custom_station}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHintStyle}" Margin="0,0,0,4"
                                   Text="{l:T radio.saved_empty}"
                                   Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding SavedFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StationFolderViewModel}">
                                    <StackPanel Margin="0,4,0,4">
                                        <Border Padding="4,6,4,2" Background="Transparent"
                                                Visibility="{Binding HasName, Converter={StaticResource BoolToVisibility}}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{l:T radio.folder.rename}" Click="OnRenameFolder" />
                                                    <MenuItem Header="{l:T radio.folder.dissolve}" Click="OnDissolveFolder" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Stations.Count, StringFormat=' ({0})'}" Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Stations}" ItemTemplate="{StaticResource StationTemplate}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Directory results -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding ResultsHeader}" Style="{StaticResource SectionHeaderStyle}" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0" Style="{StaticResource IconButtonStyle}" Content="&#xE80F;"
                                    Command="{Binding LoadPopularCommand}" ToolTip="{l:T radio.show_popular_tooltip}" AutomationProperties.Name="{l:T radio.popular}" />
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,8"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4"
                                   Visibility="{Binding EmptyText, Converter={StaticResource NullToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource StationTemplate}"
                                      VirtualizingPanel.IsVirtualizing="True" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SettingHintStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Text="{Binding ProviderName, StringFormat={l:T radio.provider}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
