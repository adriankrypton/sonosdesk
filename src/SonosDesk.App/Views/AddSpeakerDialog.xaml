<Window x:Class="SonosDesk.App.Views.AddSpeakerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SonosDesk.App.Localization"
        Title="{l:T dlg.speaker.title}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=AddressBox}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{l:T dlg.speaker.header}" Style="{DynamicResource SubtitleTextBlockStyle}" FontSize="18" />
        <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Style="{StaticResource SettingHintStyle}" FontSize="13"
                   Text="{l:T dlg.speaker.hint}" />

        <TextBlock Text="{l:T dlg.speaker.address}" Margin="0,0,0,4" />
        <TextBox x:Name="AddressBox" TextChanged="OnAddressChanged" AutomationProperties.Name="{l:T dlg.speaker.address_name}"
                 ToolTip="{l:T dlg.speaker.address_tooltip}" />
        <TextBlock x:Name="ValidationText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T dlg.speaker.example}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:T dlg.speaker.cancel}" MinWidth="100" IsCancel="True" />
            <Button x:Name="AddButton" Content="{l:T dlg.speaker.add}" MinWidth="120" Margin="8,0,0,0" IsDefault="True" IsEnabled="False"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnAdd" />
        </StackPanel>
    </StackPanel>
</Window>
