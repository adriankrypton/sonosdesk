<Window x:Class="SonosDesk.App.Views.SpeakerInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:SonosDesk.App.Localization"
        xmlns:vm="clr-namespace:SonosDesk.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SpeakerInfoViewModel}"
        Title="{Binding Title}" Width="500" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,14,0">
                <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding RoomName}" Style="{DynamicResource SubtitleTextBlockStyle}" FontSize="18" />
                <TextBlock Text="{Binding Model}" Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{Binding Model, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource CardStyle}" Margin="0" Padding="16,10">
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SpeakerInfoRow}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <!-- Read-only TextBox so values (IP, MAC, IDs) can be selected and copied. -->
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0"
                                     Background="Transparent" TextWrapping="Wrap" MinHeight="0"
                                     AutomationProperties.Name="{Binding Label}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button MinWidth="110" Command="{Binding CopyCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{l:T info.copy}" />
                </StackPanel>
            </Button>
            <Button Content="{l:T info.close}" MinWidth="110" Margin="8,0,0,0" IsCancel="True" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
