<UserControl x:Class="SonosDesk.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SonosDesk.App.ViewModels"
             xmlns:views="clr-namespace:SonosDesk.App.Views"
             xmlns:l="clr-namespace:SonosDesk.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="RowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="32,24,32,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72B;" Margin="-8,0,8,0"
                        Command="{Binding DataContext.ShowNowPlayingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{l:T common.back}" AutomationProperties.Name="{l:T common.back}" />
                <TextBlock Text="{l:T settings.title}" Style="{DynamicResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,8,32,24" MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- Appearance and start -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.appearance.title}" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T settings.language.label}" Style="{StaticResource SettingLabelStyle}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      AutomationProperties.Name="{l:T settings.language.label}" />
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T settings.theme.label}" Style="{StaticResource SettingLabelStyle}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                      AutomationProperties.Name="{l:T settings.theme.label}" />
                        </Grid>
                        <CheckBox Content="{l:T settings.start.with_windows}" IsChecked="{Binding StartWithWindows}" Margin="0,8,0,0" />
                        <CheckBox Content="{l:T settings.start.minimized}" IsChecked="{Binding StartMinimized}" Margin="0,8,0,0" />
                        <CheckBox Content="{l:T settings.start.close_to_tray}" IsChecked="{Binding CloseToTray}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource SettingHintStyle}" Margin="28,2,0,0"
                                   Text="{l:T settings.start.close_to_tray_hint}" />
                        <CheckBox Content="{l:T settings.start.media_controls}" IsChecked="{Binding WindowsMediaControls}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource SettingHintStyle}" Margin="28,2,0,0"
                                   Text="{l:T settings.start.media_controls_hint}" />
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.network.title}" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T settings.network.interval}" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="{l:T settings.network.interval_hint}" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="15" Maximum="600" SmallChange="15" LargeChange="60" TickFrequency="15"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Value="{Binding DiscoveryIntervalSeconds}" AutomationProperties.Name="{l:T settings.network.interval_name}" />
                            <TextBlock Grid.Column="2" Text="{Binding DiscoveryIntervalSeconds, StringFormat='{}{0} s'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding ReadStreamMetadata}"
                                  Content="{l:T settings.network.stream_metadata}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}" Margin="28,2,0,0"
                                   Text="{l:T settings.network.stream_metadata_hint}" />
                        <TextBlock Text="{l:T settings.network.manual_addresses}" Margin="0,12,0,4" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox Text="{Binding ManualAddresses, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{l:T settings.network.manual_addresses}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                   Text="{l:T settings.network.manual_addresses_hint}" />
                    </StackPanel>
                </Border>

                <!-- Rooms and volume -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.rooms.title}" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T settings.rooms.default_room}" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="{l:T settings.rooms.default_room_hint}" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding RoomNames}" Text="{Binding DefaultRoom, UpdateSourceTrigger=LostFocus}"
                                      VerticalAlignment="Center" AutomationProperties.Name="{l:T settings.rooms.default_room}" />
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T settings.rooms.volume_step}" Style="{StaticResource SettingLabelStyle}" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="15" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                    Value="{Binding VolumeStep}" AutomationProperties.Name="{l:T settings.rooms.volume_step_name}" />
                            <TextBlock Grid.Column="2" Text="{Binding VolumeStep}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T settings.rooms.volume_fade}" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="{l:T settings.rooms.volume_fade_hint}" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="0.5" SmallChange="0.5" LargeChange="1"
                                    VerticalAlignment="Center" Value="{Binding VolumeFadeSeconds}" AutomationProperties.Name="{l:T settings.rooms.volume_fade}" />
                            <TextBlock Grid.Column="2" Text="{Binding VolumeFadeSeconds, StringFormat='{}{0:0.#} s'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="{l:T settings.profiles.title}" Style="{StaticResource SettingLabelStyle}" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VolumeProfileItem}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.profiles.name}" />
                                        <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="100" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                Value="{Binding Volume}" AutomationProperties.Name="{Binding Name, StringFormat={l:T settings.profiles.volume_for}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Volume}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <Button Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;"
                                                Command="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="{l:T settings.profiles.remove}" AutomationProperties.Name="{l:T settings.profiles.remove}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{l:T settings.profiles.add}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding AddProfileCommand}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                   Text="{l:T settings.profiles.hint}" />
                    </StackPanel>
                </Border>

                <!-- Quick actions -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.actions.title}" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QuickActionItem}">
                                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" AutomationProperties.Name="{l:T settings.actions.name}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <StackPanel Visibility="{Binding IsSimple, Converter={StaticResource BoolToVisibility}}">
                                                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" AutomationProperties.Name="{l:T settings.actions.kind}" />
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox IsEditable="True" Text="{Binding Room, UpdateSourceTrigger=LostFocus}"
                                                                  ItemsSource="{Binding DataContext.RoomNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  ToolTip="{l:T settings.actions.room_tooltip}" AutomationProperties.Name="{l:T settings.actions.room}" />
                                                        <TextBox Grid.Column="1" Margin="6,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="{l:T settings.actions.value_tooltip}" AutomationProperties.Name="{l:T settings.actions.value}" />
                                                        <TextBox Grid.Column="2" Text="{Binding Argument, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="{l:T settings.actions.argument_tooltip}" AutomationProperties.Name="{l:T settings.actions.argument}" />
                                                    </Grid>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSimple, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Margin="12,4,0,0" VerticalAlignment="Top" Content="{l:T settings.actions.show_in_tray}" IsChecked="{Binding ShowInTray}" />
                                            <Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Top" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;"
                                                    Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{l:T settings.actions.remove}" AutomationProperties.Name="{l:T settings.actions.remove}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{l:T settings.actions.add}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddActionCommand}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                   Text="{l:T settings.actions.hint}" />
                    </StackPanel>
                </Border>

                <!-- Automations -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.automations.title}" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding Automations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AutomationItem}">
                                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" AutomationProperties.Name="{l:T settings.automations.enabled}" MinWidth="0" />
                                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.automations.name}" />
                                            <TextBox Grid.Column="2" Margin="6,0" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{l:T settings.automations.time_tooltip}" AutomationProperties.Name="{l:T settings.automations.time}" />
                                            <ComboBox Grid.Column="3" SelectedValue="{Binding QuickActionId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                                                      ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      AutomationProperties.Name="{l:T settings.automations.action}" />
                                            <Button Grid.Column="4" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;"
                                                    Command="{Binding DataContext.RemoveAutomationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{l:T settings.automations.remove}" AutomationProperties.Name="{l:T settings.automations.remove}" />
                                            <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" ItemsSource="{Binding Days}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:DayToggle}">
                                                        <ToggleButton Style="{StaticResource ChipToggleStyle}" Padding="10,3" Margin="0,0,6,0"
                                                                      Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{l:T settings.automations.add}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding AddAutomationCommand}" />
                        <Grid Style="{StaticResource RowStyle}" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T settings.startup_action.label}" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="{l:T settings.startup_action.hint}" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding StartupActionOptions}" SelectedItem="{Binding SelectedStartupAction}"
                                      AutomationProperties.Name="{l:T settings.startup_action.label}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.hotkeys.title}" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Content="{l:T settings.hotkeys.enabled}" IsChecked="{Binding HotkeysEnabled}" Margin="0,0,0,8" />
                        <Grid IsEnabled="{Binding HotkeysEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{l:T settings.hotkeys.play_pause}" Style="{StaticResource SettingLabelStyle}" />
                            <views:HotkeyBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding HotkeyPlayPause, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.hotkeys.play_pause_box}" />
                            <TextBlock Grid.Row="1" Text="{l:T settings.hotkeys.next}" Style="{StaticResource SettingLabelStyle}" />
                            <views:HotkeyBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding HotkeyNext, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.hotkeys.next_box}" />
                            <TextBlock Grid.Row="2" Text="{l:T settings.hotkeys.previous}" Style="{StaticResource SettingLabelStyle}" />
                            <views:HotkeyBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding HotkeyPrevious, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.hotkeys.previous_box}" />
                            <TextBlock Grid.Row="3" Text="{l:T settings.hotkeys.volume_up}" Style="{StaticResource SettingLabelStyle}" />
                            <views:HotkeyBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding HotkeyVolumeUp, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.hotkeys.volume_up_box}" />
                            <TextBlock Grid.Row="4" Text="{l:T settings.hotkeys.volume_down}" Style="{StaticResource SettingLabelStyle}" />
                            <views:HotkeyBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding HotkeyVolumeDown, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.hotkeys.volume_down_box}" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                   Text="{l:T settings.hotkeys.hint}" />
                    </StackPanel>
                </Border>

                <!-- Backend -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.backend.title}" Style="{StaticResource SectionHeaderStyle}" />
                        <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" HorizontalAlignment="Left" MinWidth="420"
                                  AutomationProperties.Name="{l:T settings.backend.name}" />
                        <TextBlock Style="{StaticResource SettingHintStyle}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Text="{l:T settings.backend.restart_hint}"
                                   Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}" />

                        <Expander Header="{l:T settings.control_api.header}" Margin="0,16,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource SettingHintStyle}" Margin="0,0,0,12"
                                           Text="{l:T settings.control_api.intro}" />
                                <Grid Style="{StaticResource RowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T settings.control_api.client_key}" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBox Grid.Column="1" Text="{Binding ClientKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.control_api.client_key}" />
                                </Grid>
                                <Grid Style="{StaticResource RowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T settings.control_api.client_secret}" Style="{StaticResource SettingLabelStyle}" />
                                    <PasswordBox x:Name="SecretBox" Grid.Column="1" PasswordChanged="OnSecretChanged" AutomationProperties.Name="{l:T settings.control_api.client_secret}" />
                                    <Button Grid.Column="2" Margin="8,0,0,0" Content="{l:T settings.control_api.save_secret}" Command="{Binding SaveClientSecretCommand}" />
                                </Grid>
                                <TextBlock Margin="160,0,0,0" Style="{StaticResource SettingHintStyle}" Text="{l:T settings.control_api.secret_stored}"
                                           Visibility="{Binding HasClientSecret, Converter={StaticResource BoolToVisibility}}" />
                                <Grid Style="{StaticResource RowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T settings.control_api.redirect_uri}" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBox Grid.Column="1" Text="{Binding RedirectUri, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.control_api.redirect_uri}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="160,8,0,0">
                                    <Button Content="{l:T settings.control_api.sign_in}" Style="{DynamicResource AccentButtonStyle}" Command="{Binding StartAuthorizationCommand}" />
                                    <Button Content="{l:T settings.control_api.sign_out}" Margin="8,0,0,0" Command="{Binding SignOutCommand}" />
                                </StackPanel>
                                <Grid Style="{StaticResource RowStyle}" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T settings.control_api.redirected_url}" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBox Grid.Column="1" Text="{Binding RedirectedUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T settings.control_api.redirected_url}" />
                                    <Button Grid.Column="2" Margin="8,0,0,0" Content="{l:T settings.control_api.complete}" Command="{Binding CompleteAuthorizationCommand}" />
                                </Grid>
                                <TextBlock Margin="160,4,0,0" Text="{Binding ControlApiStatus}" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.updates.title}" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{Binding Updates.CurrentVersionWithDate, StringFormat={l:T settings.updates.current}}" />
                        <CheckBox Content="{l:T settings.updates.check_on_start}" IsChecked="{Binding CheckForUpdates}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource SettingHintStyle}" Margin="28,2,0,0"
                                   Text="{l:T settings.updates.check_on_start_hint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{l:T settings.updates.check_now}" Command="{Binding Updates.CheckNowCommand}"
                                    IsEnabled="{Binding Updates.IsChecking, Converter={StaticResource InverseBool}}" />
                            <Button Content="{l:T update.download}" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                                    Command="{Binding Updates.OpenReleaseCommand}"
                                    Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                            <views:BusySpinner Width="14" Height="14" Thickness="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding Updates.IsChecking, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Updates.StatusText}" Style="{StaticResource SettingHintStyle}" Margin="0,8,0,0"
                                   Visibility="{Binding Updates.StatusText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- About (collapsed by default) -->
                <Border Style="{StaticResource CardStyle}">
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="{l:T settings.about.title}" FontSize="14" FontWeight="SemiBold" />
                        </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="13">
                            <Run Text="{l:T settings.about.developed_by}" />
                            <Hyperlink NavigateUri="https://github.com/adriankrypton" RequestNavigate="OnLinkNavigate">adriankrypton</Hyperlink>
                            <Run Text="(github.com/adriankrypton)." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SettingHintStyle}" FontSize="13" Margin="0,6,0,0"
                                   Text="{l:T settings.about.license}" />

                        <TextBlock Text="{l:T settings.about.sources_title}" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SettingHintStyle}" FontSize="13">
                            <Run FontWeight="SemiBold" Text="{l:T settings.about.sonos_label}" />
                            <Run Text="{l:T settings.about.sonos_text}" />
                            <Hyperlink NavigateUri="https://docs.sonos.com/" RequestNavigate="OnLinkNavigate">Sonos Control API</Hyperlink><Run Text="." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SettingHintStyle}" FontSize="13" Margin="0,8,0,0">
                            <Run FontWeight="SemiBold" Text="{l:T settings.about.radio_label}" />
                            <Run Text="{l:T settings.about.radio_text}" />
                            <Hyperlink NavigateUri="https://www.radio-browser.info/" RequestNavigate="OnLinkNavigate">Radio Browser (radio-browser.info)</Hyperlink><Run Text="{l:T settings.about.radio_text_after}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SettingHintStyle}" FontSize="13" Margin="0,8,0,0">
                            <Run FontWeight="SemiBold" Text="{l:T settings.about.now_playing_label}" />
                            <Run Text="{l:T settings.about.now_playing_text}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SettingHintStyle}" FontSize="13" Margin="0,8,0,0">
                            <Run FontWeight="SemiBold" Text="{l:T settings.about.software_label}" />
                            <Run Text="{l:T settings.about.software_text}" />
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0" Text="{Binding SettingsFolder, StringFormat={l:T settings.about.data_folder}}" Style="{StaticResource SettingHintStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{l:T settings.about.open_data_folder}" Command="{Binding OpenSettingsFolderCommand}" />
                            <Button Content="{l:T settings.about.open_logs}" Margin="8,0,0,0" Command="{Binding OpenLogFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="32,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T common.discard}" Command="{Binding DiscardCommand}" MinWidth="110" />
                <Button Content="{l:T common.save}" Margin="8,0,0,0" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
